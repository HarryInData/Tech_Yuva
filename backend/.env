# ==============================================================================
# TECH YUVA BACKEND ENVIRONMENT CONFIGURATION (Backend Service Port: 5000)
# ==============================================================================

PORT=5000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Nodemailer / Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=techyuva.org@gmail.com
SMTP_PASS=placeholder-app-password
EMAIL_FROM="Tech Yuva Guild Council <noreply@techyuva.org>"

# App URLs
ADMIN_NOTIFICATION_EMAIL=techyuva.org@gmail.com
FRONTEND_URL=http://localhost:8080
DISCORD_INVITE_URL=https://discord.gg/techyuva
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/
