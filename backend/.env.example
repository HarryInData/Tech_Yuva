# ==============================================================================
# TECH YUVA BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your actual secrets
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# Supabase (Project Settings -> API)
# Get these from your Supabase Dashboard: Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
# Public anon key (safe for client, used for public verification fallback)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# CRITICAL: Service role key is server-only! Grants full bypass of RLS for admin operations.
# NEVER commit or expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nodemailer / Email (SMTP)
# Use Gmail App Password, Resend SMTP, SendGrid, or Mailtrap for development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=techyuva.org@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="Tech Yuva Guild Council <noreply@techyuva.org>"

# Community & Admin Configuration
ADMIN_NOTIFICATION_EMAIL=techyuva.org@gmail.com
FRONTEND_URL=http://localhost:3000
DISCORD_INVITE_URL=https://discord.gg/techyuva
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/
